/* cc-mirror screen layout, status outlines, and the center overlay. */

Screen {
    layers: base overlay;
    background: $surface;
}

#header {
    dock: top;
    height: 1;
    width: 100%;
    background: $panel;
    color: $text;
}

#header.-has-waiting {
    background: $panel-lighten-1;
}

#body {
    width: 100%;
    height: 1fr;
    layer: base;
}

/* ---- sidebar ---- */

#sidebar {
    width: 26;
    min-width: 20;
    height: 100%;
    border-right: solid $panel-lighten-2;
    padding: 0 1;
    background: $surface;
}

.group-heading {
    width: 100%;
    height: 1;
    padding: 0;
    margin-top: 1;
    color: $text;
}

.session-row {
    width: 100%;
    height: 1;
}

.session-row:hover {
    background: $boost;
}

.session-row.-current {
    background: $primary-darken-2;
}

.session-row:focus {
    background: $primary-darken-1;
}

.agent-toggle {
    width: 100%;
    height: 1;
}

.agent-toggle:hover {
    background: $boost;
}

.agent-toggle:focus {
    background: $primary-darken-1;
}

.agent-row {
    width: 100%;
    height: 1;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

.agent-row:hover {
    background: $boost;
}

.agent-row:focus {
    background: $primary-darken-1;
}

/* ---- preview stack ---- */

#previews {
    width: 1fr;
    height: 100%;
    padding: 0 1;
    background: $surface;
}

.group-rule {
    width: 100%;
    height: 1;
    margin: 1 0 0 0;
    color: #8a8a8a;
}

PreviewBox {
    width: 100%;
    height: auto;
    margin: 1 0 0 0;
    padding: 0 1;
    border: round $panel-lighten-2;
    border-title-align: left;
    border-subtitle-align: right;
    /* One semantic line per row: the box stays scannable when narrow. */
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

PreviewBox:hover {
    background: $boost;
}

PreviewBox:focus {
    background: $primary-darken-3;
}

PreviewBox.-busy {
    border: solid cyan;
    border-title-color: cyan;
    border-subtitle-color: cyan;
}

PreviewBox.-waiting {
    border: double orange;
    border-title-color: orange;
    border-subtitle-color: orange;
    text-style: bold;
}

PreviewBox.-idle {
    border: solid #8a8a8a;
    border-title-color: #8a8a8a;
    border-subtitle-color: #8a8a8a;
}

PreviewBox.-dead {
    border: solid #303030;
    border-title-color: #606060;
    border-subtitle-color: #606060;
    color: #606060;
}

PreviewBox.-busy.-ro {
    border: dashed cyan;
}

PreviewBox.-waiting.-ro {
    border: dashed orange;
}

PreviewBox.-idle.-ro {
    border: dashed #8a8a8a;
}

PreviewBox.-dead.-ro {
    border: dashed #303030;
}

/* ---- center overlay ---- */

#center {
    layer: overlay;
    width: 100%;
    height: 100%;
    margin: 2 3 2 30;
    background: $surface;
    border: double orange;
    border-title-align: left;
    border-subtitle-align: right;
    border-title-color: orange;
    border-subtitle-color: #8a8a8a;
    padding: 0 1;
    overflow: auto auto;
}

#pane-mirror {
    width: auto;
    height: auto;
    min-width: 100%;
    background: $surface;
}

#transcript-view {
    width: 100%;
    height: 100%;
}

#transcript-body {
    width: auto;
    height: auto;
}
