+// --- Color-killer sanitization (local patch; workflow-helper/claude/auto-retry-colors) ---
+// Cursor's agent shell exports TERM=dumb, NO_COLOR=1, FORCE_COLOR=0. Any of these
+// reaching the pane renders the Claude Code TUI colorless (TERM=dumb breaks it
+// outright). TERM must never cross into a pane at all — the pane's tmux-set TERM
+// is the only correct value there.
+const COLOR_KILLERS = ['NO_COLOR', 'NODE_DISABLE_COLORS', 'CURSOR_AGENT'];
+
+function isColorKiller(k, v) {
+  if (COLOR_KILLERS.includes(k)) return true;
+  if (k === 'FORCE_COLOR' && v === '0') return true;
+  if (k === 'TERM' && v === 'dumb') return true;
+  return false;
+}
+
+export function sanitizeInteractiveEnv(env) {
+  const out = {};
+  for (const [k, v] of Object.entries(env)) {
+    if (v == null || isColorKiller(k, v)) continue;
+    out[k] = v;
+  }
+  return out;
+}
