+// Size the detached session to the launching terminal (-x/-y). Without it the
+// session is born 80x24, claude renders its first frame there, and the attach a
+// moment later delivers a SIGWINCH mid-first-paint — the classic stale-width /
+// artifact render. With the real size there is no resize at attach at all.
+export function buildNewSessionArgs(sessionName, innerCmd, size = null) {
+  const sizeArgs = size && size.cols > 0 && size.rows > 0
+    ? ['-x', String(size.cols), '-y', String(size.rows)]
+    : [];
+  return ['new-session', '-d', ...sizeArgs, '-s', sessionName, innerCmd];
 }
 
