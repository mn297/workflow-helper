+// Env vars that kill Claude Code / TUI colors when a non-interactive host (Cursor
+// agent, CI, etc.) first spawned the tmux server. Those hosts set TERM=dumb /
+// NO_COLOR=1 / FORCE_COLOR=0 globally; tmux then inherits them into every later
+// pane unless we strip them here.
+const COLOR_KILLERS = new Set([
+  'NO_COLOR',
+  'NODE_DISABLE_COLORS',
+  'CURSOR_AGENT',
+]);
+
+// Strip color-suppressing env and never forward a dumb TERM into the TUI.
+// Also drops Cursor-agent markers that leak into tmux global env.
+export function sanitizeInteractiveEnv(env = process.env) {
+  const out = { ...env };
+  for (const k of COLOR_KILLERS) delete out[k];
+  if (out.FORCE_COLOR === '0' || out.FORCE_COLOR === 'false') delete out.FORCE_COLOR;
+  if (out.TERM === 'dumb') delete out.TERM;
+  return out;
+}
